  "modified": "2026-03-30 16:13:22.025194",
  "module": "Addsol Nl Custom",
  "name": "Stock Entry Ledger",
  "prepared_report": 0,
  "query": null,
  "ref_doctype": "Stock Ledger Entry",
  "reference_report": null,
  "report_name": "Stock Entry Ledger",
  "report_script": "import frappe\n\ndef execute(filters=None):\n    columns = get_columns()\n    data = get_data(filters)\n    return columns, data\n\n\ndef get_columns():\n    return [\n        {\"label\": \"Item\", \"fieldname\": \"item_code\", \"fieldtype\": \"Link\", \"options\": \"Item\", \"width\": 140},\n        {\"label\": \"Warehouse\", \"fieldname\": \"warehouse\", \"fieldtype\": \"Link\", \"options\": \"Warehouse\", \"width\": 140},\n        {\"label\": \"Batch\", \"fieldname\": \"batch_no\", \"fieldtype\": \"Link\", \"options\": \"Batch\", \"width\": 140},\n        {\"label\": \"Stock Qty (Kg)\", \"fieldname\": \"qty\", \"fieldtype\": \"Float\", \"width\": 140},\n        {\"label\": \"Conversion\", \"fieldname\": \"conversion\", \"fieldtype\": \"Float\", \"width\": 120},\n        {\"label\": \"Qty (Nos)\", \"fieldname\": \"nos\", \"fieldtype\": \"Float\", \"width\": 120},\n    ]\n\n\ndef get_data(filters):\n\n    conditions = \"\"\n    if filters.get(\"item_code\"):\n        conditions += f\" AND sle.item_code = '{filters.get('item_code')}'\"\n    if filters.get(\"warehouse\"):\n        conditions += f\" AND sle.warehouse = '{filters.get('warehouse')}'\"\n\n    rows = frappe.db.sql(f\"\"\"\n        SELECT\n            sle.item_code,\n            sle.warehouse,\n            sle.batch_no,\n            SUM(sle.actual_qty) as qty\n        FROM `tabStock Ledger Entry` sle\n        WHERE sle.is_cancelled = 0\n        {conditions}\n        GROUP BY sle.item_code, sle.warehouse, sle.batch_no\n        HAVING qty != 0\n    \"\"\", as_dict=1)\n\n    data = []\n    totals = {}\n\n    for row in rows:\n        conversion = 1\n\n        if row.batch_no:\n            conversion = frappe.db.get_value(\n                \"Batch\",\n                row.batch_no,\n                \"custom_conversion_factor\"\n            ) or 1\n\n        nos = row.qty / conversion if conversion else 0\n\n        row.conversion = conversion\n        row.nos = nos\n\n        data.append(row)\n\n        # totals\n        key = (row.item_code, row.warehouse)\n\n        if key not in totals:\n            totals[key] = {\"kg\": 0, \"nos\": 0}\n\n        totals[key][\"kg\"] += row.qty\n        totals[key][\"nos\"] += nos\n\n    # add summary rows\n    for (item, wh), val in totals.items():\n        data.append({\n            \"item_code\": item,\n            \"warehouse\": wh,\n            \"batch_no\": \"TOTAL\",\n            \"qty\": val[\"kg\"],\n            \"conversion\": \"\",\n            \"nos\": val[\"nos\"]\n        })\n\n    return data",
  "report_type": "Script Report",
